@inherits LayoutComponentBase
@* Required *@
<MudThemeProvider IsDarkMode=true />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />
<MudLayout>
    <MudAppBar>
        <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All" >Entropia Inventory Share</MudNavLink>
        <MudNavLink Href="/UpdateInventory" Match="NavLinkMatch.Prefix">Update Inventory</MudNavLink>

    </MudAppBar>
    <MudMainContent Style="padding-left: 10px;padding-right: 10px;">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
