@page "/UpdateInventory"
@page "/UpdateInventory/{LicenseNumber}"
<PageTitle>Update Inventory</PageTitle>

<MudStack>
    <MudTextField Validation="@(new Func<string, string>(InventoryValid))" T="string" Placeholder="Paste your items here" Variant="Variant.Outlined" DebounceInterval=500 Lines=4 TextChanged="ParseData">
    </MudTextField>
    <MudLink hidden="@(_items.Count() > 0)" Href="https://account.entropiauniverse.com/account/my-account/my-items/" Target="_blank">Open and Copy(Ctrl-A then Ctrl-C) the content from Entropia Universe Items</MudLink>

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify=Justify.FlexStart Spacing="4">
        <MudPaper Class="pa-3">@($"TT Value : {_items.Sum(u => u.Value):N2}")</MudPaper>
        <MudPaper Class="pa-3">@($"Items : {_items.Count()}")</MudPaper>
    </MudStack>
    <MudStack hidden="@(string.IsNullOrEmpty(licenseAvatar))" Row="true" AlignItems="AlignItems.Start" Justify=Justify.FlexStart Spacing="4">

        <MudTextField Disabled="@(_items.Count() == 0)" T="string" AutoGrow=false Placeholder="Add a description for current state" Variant="Variant.Text" @bind-Value="SessionTag" Label="" Underline=true Dense="true"
                      Margin="Margin.None">
        </MudTextField>
        <MudButton Disabled="@(_items.Count() == 0)" >Save Current State</MudButton>
    </MudStack>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" @ref="tabs">
        <MudTabPanel Text="Shared">
            <MudStack>
                <MudStack Row="true">
                    <MudPaper Class="pa-3">@($"TT Value : {_items.Where(u => u.Shared).Sum(u => u.Value):N2}")</MudPaper>
                    <MudPaper Class="pa-3">@($"Items : {_items.Where(u => u.Shared).Count()}")</MudPaper>
                </MudStack>
                <MudDataGrid Dense="true" Items="@_items.Where(u => u.Shared).OrderByDescending(u => u.Value)" Filterable="true" SortMode="SortMode.None" Groupable="false" FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive">
                    <Columns>
                        <PropertyColumn Property="x => x.Shared" Editable=true Filterable="false">
                            <CellTemplate>
                                <MudCheckBox T=bool @bind-Value=context.Item.Shared ReadOnly=false @bind-Value:after="() => SharedItemChanged(context.Item)" />
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Name" />
                        <PropertyColumn Property="x => x.Quantity" />
                        <PropertyColumn Property="x => x.Value" Title="Value" />
                        <PropertyColumn Property="x => x.Container" />
                        <PropertyColumn Property="x => x.MarkupAddToTT" Title="TT+ Value" Editable=true Filterable="false">
                            <CellTemplate>
                                <MudNumericField T=double? Min="0" Step=1 @bind-Value=context.Item.MarkupAddToTT ReadOnly=@(context.Item.Quantity > 1 || context.Item.Name.EndsWith("L)")) @bind-Value:after="() => SharedItemValueChanged(context.Item)" />
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.MarkupPercentage" Title="MU (%)" Editable=true Filterable="false">
                            <CellTemplate>
                                <MudNumericField T=double? Step=0.5 Min=100 Format="N2" @bind-Value=context.Item.MarkupPercentage ReadOnly=@(context.Item.Quantity == 1 && !context.Item.Name.EndsWith("L)")) @bind-Value:after="() => SharedItemValueChanged(context.Item)" />
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.PerItemPrice" Title="Per Item" Editable=true Filterable="false">
                            <CellTemplate>
                                <MudNumericField T=double? Min="0" Step=0.5 @bind-Value=context.Item.PerItemPrice ReadOnly=@(context.Item.Name.EndsWith("L)")) @bind-Value:after="() => SharedItemValueChanged(context.Item)" />
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Tier" Title="Tier" Editable=true Filterable="false">
                            <CellTemplate>
                                <MudNumericField T=double? Min="1" Max="10" Step=0.01 @bind-Value=context.Item.Tier ReadOnly=@(!context.Item.HasTier) @bind-Value:after="() => SharedItemValueChanged(context.Item)" />
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.TIR" Title="TIR" Editable=true Filterable="false">
                            <CellTemplate>
                                <MudNumericField T=int? Min="0" Step=1 @bind-Value=context.Item.TIR ReadOnly=@(!context.Item.HasTier) @bind-Value:after="() => SharedItemValueChanged(context.Item)" />
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Shop" Title="Shop" Editable=true Filterable="false">
                            <CellTemplate>
                                <MudTextField @bind-Value=context.Item.Shop ReadOnly=@(!context.Item.InShop) @bind-Value:after="() => SharedItemValueChanged(context.Item)" />
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.ExtraData" Title="Info" Editable=true Filterable="false">
                            <CellTemplate>
                                <MudTextField @bind-Value=context.Item.ExtraData @bind-Value:after="() => SharedItemValueChanged(context.Item)" />
                            </CellTemplate>
                        </PropertyColumn>
                    </Columns>
                </MudDataGrid>
            </MudStack>

        </MudTabPanel>
        <MudTabPanel Text="Carried/Storage" >
            <MudStack>
                <MudStack Row="true">
                    <MudPaper Class="pa-3">@($"TT Value : {_items.Where(u => !u.InAuction && !u.InShop).Sum(u => u.Value):N2}")</MudPaper>
                    <MudPaper Class="pa-3">@($"Items : {_items.Where(u => !u.InAuction && !u.InShop).Count()}")</MudPaper>
                </MudStack>
                <MudDataGrid Dense="true" Items="@_items.Where(u => !u.InAuction && !u.InShop).OrderByDescending(u => u.Value)" Filterable="true" SortMode="SortMode.None" Groupable="false" FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive">
                    <Columns>
                        <PropertyColumn Property="x => x.Shared" Editable=true>
                            <CellTemplate>
                                <MudCheckBox T=bool @bind-Value=context.Item.Shared ReadOnly=false @bind-Value:after="()=>SharedItemChanged(context.Item)" />
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Name" />
                        <PropertyColumn Property="x => x.Quantity" />
                        <PropertyColumn Property="x => x.Value" Title="Value" />
                        <PropertyColumn Property="x => x.Container" />
                    </Columns>
                </MudDataGrid>
            </MudStack>

        </MudTabPanel>
        <MudTabPanel Text="Auction">
            <MudStack>
                <MudStack Row="true">
                    <MudPaper Class="pa-3">@($"TT Value : {_items.Where(u => u.InAuction).Sum(u => u.Value):N2}")</MudPaper>
                    <MudPaper Class="pa-3">@($"Items : {_items.Where(u => u.InAuction).Count()}")</MudPaper>
                </MudStack>
                <MudDataGrid Dense="true" Items="@_items.Where(u => u.InAuction).OrderByDescending(u => u.Value)" Filterable="true" SortMode="SortMode.None" Groupable="false" FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive">
                    <Columns>
                        <PropertyColumn Property="x => x.Name" />
                        <PropertyColumn Property="x => x.Quantity" />
                        <PropertyColumn Property="x => x.Value" Title="Value" />
                        <PropertyColumn Property="x => x.Container" />
                    </Columns>
                </MudDataGrid>
            </MudStack>
        </MudTabPanel>
        <MudTabPanel Text="Shops">
            <MudStack>
                <MudStack Row="true">
                    <MudPaper Class="pa-3">@($"TT Value : {_items.Where(u => u.InShop).Sum(u => u.Value):N2}")</MudPaper>
                    <MudPaper Class="pa-3">@($"Items : {_items.Where(u => u.InShop).Count()}")</MudPaper>
                </MudStack>
                <MudDataGrid Dense="true" Items="@_items.Where(u => u.InShop).OrderByDescending(u => u.Value)" Filterable="true" SortMode="SortMode.None" Groupable="false" FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive">
                    <Columns>
                        <PropertyColumn Property="x => x.Shared" Editable=true>
                            <CellTemplate>
                                <MudCheckBox T=bool @bind-Value=context.Item.Shared ReadOnly=false @bind-Value:after="() => SharedItemChanged(context.Item)" />
                            </CellTemplate>
                        </PropertyColumn>
                        <PropertyColumn Property="x => x.Name" />
                        <PropertyColumn Property="x => x.Quantity" />
                        <PropertyColumn Property="x => x.Value" Title="Value" />
                        <PropertyColumn Property="x => x.Container" />
                    </Columns>
                </MudDataGrid>
            </MudStack>
        </MudTabPanel>

    </MudTabs>
</MudStack>


